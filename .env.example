# ==============================================================================
# Tripwire Gmail Configuration
# ==============================================================================
# To allow the agent to access your real Gmail messages:
# 1. Go to your Google Account (https://myaccount.google.com) -> Security
# 2. Make sure 2-Step Verification is turned ON
# 3. Search for "App passwords" (https://myaccount.google.com/apppasswords)
# 4. Generate an App Password (named e.g. "Tripwire Agent")
# 5. Copy the 16-character code below:

GMAIL_ADDRESS=your.email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Set to 1 to tell Tripwire to use your real Gmail inbox for read_email:
USE_REAL_GMAIL=1

# (Optional) Set to 1 to enable sending real emails via Gmail SMTP (default: 0 = simulated)
SEND_REAL_GMAIL=0
